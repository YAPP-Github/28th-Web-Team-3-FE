BACKEND_API_URL=http://localhost:8080
# 브라우저가 호출할 API base URL.
# 로컬 WebView 개발에서는 Next dev rewrite를 타도록 /api/를 사용한다.
NEXT_PUBLIC_API_URL=/api/

# 문의 채널 — 카카오 오픈채팅 URL
NEXT_PUBLIC_KAKAO_OPENCHAT_URL=

# 센트리 관련
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# 분석 — Mixpanel project token (브라우저 공개 값)
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_MIXPANEL_REPLAY_SAMPLE_PERCENT=100
