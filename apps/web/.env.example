# 브라우저가 직접 호출할 백엔드 API base URL (예: http://localhost:8080/api/)
NEXT_PUBLIC_API_URL=
# 네이티브 셸 없는 UT에서만 임시 sessionStorage 게스트 인증 활성화
NEXT_PUBLIC_ENABLE_UT_GUEST_AUTH=false

# 문의 채널 — 카카오 오픈채팅 URL
NEXT_PUBLIC_KAKAO_OPENCHAT_URL=

# 센트리 관련
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# 분석 — Mixpanel project token (브라우저 공개 값)
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_MIXPANEL_REPLAY_SAMPLE_PERCENT=100
