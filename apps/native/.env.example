# --- apps/native ---
# The WebView target. In dev point at the machine running `pnpm --filter web dev`.
# Use your LAN IP (not localhost) when testing on a physical device.
# iOS 시뮬레이터: localhost / Android 에뮬레이터: EXPO_PUBLIC_ANDROID_EMULATOR=true일 때 10.0.2.2
# EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Android 에뮬레이터에서 localhost/127.0.0.1을 Mac host(10.0.2.2)로 바꿀 때만 true.
# Android 실기기는 false로 두고 EXPO_PUBLIC_WEB_URL/EXPO_PUBLIC_API_URL에 LAN 주소를 넣는다.
# EXPO_PUBLIC_ANDROID_EMULATOR=true

# 게스트 인증 API(Spring) base URL. /api/까지 포함한다.
# iOS 시뮬레이터: http://localhost:8080/api/
# Android 에뮬레이터: EXPO_PUBLIC_ANDROID_EMULATOR=true일 때 http://10.0.2.2:8080/api/
# EXPO_PUBLIC_API_URL=http://localhost:8080/api/
