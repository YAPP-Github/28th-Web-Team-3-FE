# --- apps/native ---
# The WebView target. In dev point at the machine running `pnpm --filter web dev`.
# Use your LAN IP (not localhost) when testing on a physical device.
# iOS 시뮬레이터는 localhost, Android 에뮬레이터는 10.0.2.2로 자동 연결된다.
# 실기기에서는 localhost 대신 개발 머신의 LAN IP를 넣는다.
# EXPO_PUBLIC_WEB_URL=http://localhost:3000

# 게스트 인증 API(Spring) base URL. /api/까지 포함한다.
# Android 에뮬레이터의 localhost/127.0.0.1도 자동으로 10.0.2.2로 바뀐다.
# EXPO_PUBLIC_API_URL=http://localhost:8080/api/
